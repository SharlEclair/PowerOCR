<Window
    x:Class="PowerOCR.UI.OcrStatusToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TextExtractorToast"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border
        x:Name="PillBorder"
        Margin="16"
        Padding="18,10"
        Background="#EE1F1F1F"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        CornerRadius="22"
        SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Direction="270"
                Opacity="0.45"
                ShadowDepth="4"
                Color="Black" />
        </Border.Effect>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                x:Name="IconTextBlock"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
                FontSize="16"
                Foreground="#60CDFF"
                Text="&#xE946;" />
            <TextBlock
                x:Name="MessageTextBlock"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Text, Segoe UI"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#FFFFFF"
                Text="Cleaning text with Gemini..." />
        </StackPanel>
    </Border>
</Window>
