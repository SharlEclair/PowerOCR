<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PowerOCR.UI.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PowerOCR Capture Overlay"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- Static freeze-frame desktop capture -->
        <Image x:Name="BackgroundImage"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Semi-transparent dimming tint -->
        <Rectangle x:Name="DimmingTint"
                   Fill="#A6000000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

        <!-- Transparent drawing canvas for pointer capture and marquee -->
        <Canvas x:Name="DrawingCanvas"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerPressed="OnCanvasPointerPressed"
                PointerMoved="OnCanvasPointerMoved"
                PointerReleased="OnCanvasPointerReleased">

            <!-- Selection marquee border -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="#FFFFFFFF"
                    BorderThickness="2"
                    Background="#1AFFFFFF"
                    Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
